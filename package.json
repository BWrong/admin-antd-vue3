{
  "name": "antd-vue3",
  "version": "0.3.1",
  "author": {
    "name": "BWrong",
    "email": "ibwrong@foxmail.com",
    "url": "https://github.com/BWrong"
  },
  "description": "",
  "keywords": [],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "serve": "vite --host",
    "serve:mock": "vite --mode mock --host",
    "build": "vite build",
    "build:check": "npm run type-check && npm run build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "vp lint . --fix",
    "format": "oxfmt src/",
    "release": "release-it",
    "changelog": "release-it --changelog",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@bprogress/core": "^1.3.4",
    "@bwrong/auth-tool": "^3.0.11",
    "@bwrong/request": "^1.0.1",
    "@bwrong/storage": "^1.1.0",
    "@vueuse/core": "^14.2.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.15.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "js-cookie": "^3.0.5",
    "pinia": "^3.0.4",
    "qs": "^6.15.1",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@plugin-web-update-notification/vite": "^2.1.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "@tsconfig/node-lts": "^24.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.12.2",
    "@unocss/eslint-config": "^66.6.8",
    "@unocss/preset-rem-to-px": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "jiti": "^2.6.1",
    "less": "^4.6.4",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.45.0",
    "oxlint": "~1.60.0",
    "postcss": "^8.5.10",
    "postcss-px-to-viewport": "^1.1.1",
    "prettier": "^3.8.3",
    "release-it": "^20.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "unocss": "^66.6.8",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.9",
    "vite-plugin-build-info": "^0.1.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-env-parse": "^1.0.15",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-iconfont": "^1.5.3",
    "vite-plugin-mock-dev-server": "^2.1.1",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.7"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "rollup"
      ]
    },
    "ignoredBuiltDependencies": [
      "simple-git-hooks"
    ],
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "less",
      "vue-demi"
    ]
  },
  "engines": {
    "node": "^22.0.0",
    "pnpm": "^10.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --allow-empty",
    "preserveUnused": true
  },
  "lint-staged": {
    "src/*.{vue,js,jsx,cjs,mjs,ts,tsx}": [
      "prettier --write",
      "vp lint --fix"
    ],
    "src/*.{css,less}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
